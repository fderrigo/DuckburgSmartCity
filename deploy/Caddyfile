# TLS e reverse proxy per la federazione SPID/CIE.
#
# Gli hostname arrivano dall'ambiente (deploy/.env), quindi questo file non
# contiene riferimenti a un dominio specifico.
#
# Caddy ottiene i certificati da Let's Encrypt in automatico al primo avvio: i
# record DNS devono gia' puntare a questa macchina e le porte 80 e 443 devono
# essere aperte, altrimenti la richiesta fallisce e si consumano tentativi.

{
	email {$ACME_EMAIL}
}

# Intestazioni comuni a tutti e tre gli host.
(comuni) {
	header {
		# Una federazione dimostrativa non deve finire nei motori di ricerca: una
		# pagina di login raggiunta senza contesto e' l'unico modo in cui puo'
		# essere fraintesa per quella di un servizio reale.
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$TRUST_ANCHOR_HOST} {
	import comuni
	reverse_proxy trust-anchor:8000
}

{$CIE_PROVIDER_HOST} {
	import comuni
	reverse_proxy cie-provider:8002
}

{$IDENTITY_HOST} {
	import comuni
	reverse_proxy identity:8001
}

# Chi arriva sull'IP nudo in http non deve vedere nulla.
# Su 443 non serve un blocco: Caddy chiude da solo le connessioni con SNI
# sconosciuto, e dichiarare :443 lo farebbe tentare un certificato senza nome.
:80 {
	respond "Not found" 404
}
