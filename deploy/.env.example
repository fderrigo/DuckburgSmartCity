# Configurazione del deploy della federazione SPID/CIE.
#
# Copia questo file in deploy/.env e mettici i tuoi hostname. Il file .env NON
# e' versionato: e' li' che vivono i riferimenti al tuo ambiente, cosi' il
# repository resta neutro e chiunque puo' deployare dove vuole.
#
#   cp deploy/.env.example deploy/.env
#   # modifica i valori
#   bash deploy/prepara-runtime.sh
#   docker compose -f deploy/docker-compose.prod.yml up -d --build

# Hostname pubblici delle tre entita'. Devono avere un record DNS che punta a
# questa macchina: Caddy chiede i certificati per questi nomi.
IDENTITY_HOST=identity.esempio.it
TRUST_ANCHOR_HOST=trust-anchor.esempio.it
CIE_PROVIDER_HOST=cie-provider.esempio.it

# Portale dei servizi online: usato per la whitelist dei ritorni SSO e per i
# link incrociati nelle pagine di Identity.
SERVIZIONLINE_URL=https://servizionline.esempio.it

# Portale informativo: link nel piede delle pagine di Identity.
PORTALE_URL=https://www.esempio.it

# Indirizzo per gli avvisi di scadenza dei certificati Let's Encrypt.
ACME_EMAIL=tuo@indirizzo.it

# Chiavi private del Relying Party, generate con scripts/genera-chiavi-rp.ps1.
# Percorso sulla macchina host, FUORI dal repository.
# Le chiavi demo versionate sono pubbliche: non usarle per un RP raggiungibile
# da Internet, chiunque potrebbe firmare token SSO validi.
RP_SECRETS_DIR=/opt/duckburg-secrets

# Limiti di memoria dei container. Alzali se la macchina ha spazio.
MEM_DJANGO=220m
MEM_IDENTITY=260m
MEM_CADDY=96m
