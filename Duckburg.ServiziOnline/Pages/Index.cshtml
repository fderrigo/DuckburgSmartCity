@page "/"
@{
    ViewData["Title"] = "Home";
    ViewData["Nav"] = "servizi";
}

<section class="wrap container-xl mt-4 mb-4" aria-labelledby="titolo-home" style="padding-top:2rem;">
    <div class="row">
        <div class="col-12">
            <span class="sezione-eyebrow badge">Cittadino attivo — PNRR Missione 1</span>
            <h1 class="display sezione-titolo" id="titolo-home">Servizi online</h1>
            <p class="sezione-sub lead">
                Qui fai le cose, non le leggi soltanto: pratiche, pagamenti e la tua area personale,
                con accesso tramite identità digitale SPID o CIE. Per informazioni e schede dei servizi
                c'è il <a href="http://localhost:5100/">portale del cittadino</a>.
            </p>
        </div>
    </div>

    <div class="card-grid row g-3">
        <div class="col-12 col-md-4 mb-3">
            <a class="card card-fumetto h-100 d-block" href="/area-personale">
                <div class="card-body">
                    <span class="icona oro" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none" stroke="#17120E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="16" cy="11" r="5" fill="#fff"/>
                            <path d="M6 27 q0 -8 10 -8 q10 0 10 8" fill="#fff"/>
                        </svg>
                    </span>
                    <h2 class="card-title h5">Area personale del cittadino</h2>
                    <p class="card-text">I tuoi dati e le tue pratiche. Accesso con SPID o CIE.</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="icona acqua" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none" stroke="#17120E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 10 h18 l-2 16 h-14 Z" fill="#fff"/>
                            <path d="M5 10 h22 M12 10 v-3 h8 v3 M13 15 v7 M19 15 v7"/>
                        </svg>
                    </span>
                    <h2 class="card-title h5">TARI online</h2>
                    <p class="card-text">Consulta e paga la tassa sui rifiuti. <em>(In arrivo nella demo.)</em></p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="icona rossa" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none" stroke="#17120E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="8" width="24" height="16" rx="2" fill="#fff"/><circle cx="11" cy="15" r="3"/><path d="M7 21 q4 -3 8 0 M18 13 h7 M18 17 h7"/>
                        </svg>
                    </span>
                    <h2 class="card-title h5">Certificati anagrafici</h2>
                    <p class="card-text">Scarica i certificati senza sportello. <em>(In arrivo nella demo.)</em></p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <a class="btn btn-fumetto" href="/area-personale">Entra nella tua area personale</a>
        </div>
    </div>
</section>
