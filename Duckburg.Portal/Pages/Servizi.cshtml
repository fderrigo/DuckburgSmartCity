@page "/servizi"
@model ServiziModel
@{
    ViewData["Title"] = "Servizi";
    ViewData["Nav"] = "servizi";
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">Servizi</span></a></li>
    </ol>
</nav>

<section class="wrap container-xl" aria-labelledby="titolo-servizi">
    <span class="sezione-eyebrow">Servizi</span>
    <h1 class="display sezione-titolo" id="titolo-servizi">Servizi</h1>
    <p class="sezione-sub">
        I servizi del Comune di Paperopoli per cittadini e famiglie. Per ogni servizio trovi scadenze,
        costi e come fare. Per una risposta immediata usa l'<a href="/assistente">assistente virtuale</a>.
    </p>

    <!-- Funzione trasversale: prenotazione appuntamento (C.SI.2.1) -->
    <div class="card card-fumetto mb-4 prenota-banner">
        <div class="card-body row align-items-center">
            <div class="col">
                <h2 style="font-size:1.1rem; margin:0;">Ti serve parlare con un ufficio?</h2>
                <p style="margin:.2rem 0 0;">Scegli ufficio, giorno e orario: la prenotazione è immediata, senza bisogno di autenticarti.</p>
            </div>
            <div class="col-auto">
                <a href="/prenota-appuntamento" class="btn btn-fumetto" data-element="appointment-booking"><span>Prenota appuntamento</span></a>
            </div>
        </div>
    </div>

    <h2 class="display" style="font-size:1.5rem; margin-bottom:1rem;">Categorie</h2>
    <div class="card-grid row" style="margin-bottom:2.2rem;">
        @foreach (var c in Model.Categorie.Where(c => Model.CategorieConServizi.Contains(c.Id)))
        {
            <div class="col-12 col-md-4 mb-3">
                <div class="card card-fumetto h-100">
                    <div class="card-body">
                        <a href="/servizi/categoria/@c.Slug" data-element="service-category-link">
                            <h3 style="font-size:1.02rem;">@c.Nome</h3>
                        </a>
                        <p>@c.Descrizione</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="display" style="font-size:1.5rem; margin-bottom:1rem;">Tutti i servizi</h2>
    <div class="card-grid row">
        @foreach (var s in Model.Servizi)
        {
            <div class="col-12 col-md-4 mb-3">
                <div class="card card-fumetto h-100">
                    <div class="card-body">
                        <span class="icona @s.ColoreIcona" aria-hidden="true">@PortalIcons.Render(s.IconaKey)</span>
                        <h3 style="font-size:1.02rem;">
                            <a href="/servizi/@s.Slug" data-element="service-link">@s.Titolo</a>
                        </h3>
                        <p>@s.DescrizioneBreve</p>
                        @if (s.Categoria != null)
                        {
                            <span class="card-data">@s.Categoria.Nome</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>
