@page "/amministrazione/sindaco"
@model AmministrazioneSindacoModel
@{
    var p = Model.Sindaco!;
    ViewData["Title"] = p.Carica;
    ViewData["Nav"] = "amministrazione";
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item"><a href="/amministrazione"><span>Amministrazione</span></a></li>
        <li class="breadcrumb-item"><a href="/amministrazione/organi-di-governo"><span>Organi di governo</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">@p.Carica</span></a></li>
    </ol>
</nav>

<section class="wrap" aria-labelledby="titolo-sindaca">
    <span class="sezione-eyebrow">Organi di governo</span>
    <h1 class="display sezione-titolo" id="titolo-sindaca">@p.Nome, @p.Carica</h1>

    <div class="scheda-grid">
        <div class="scheda-corpo">
            <div style="display:flex; gap:1.4rem; align-items:center; flex-wrap:wrap; margin-bottom:1.4rem;">
                <span style="width:140px; height:140px; display:inline-block; filter:drop-shadow(4px 4px 0 rgba(23,18,14,.85));">
                    @Html.Raw(p.RitrattoSvg)
                </span>
                <div>
                    <p style="font-weight:700; font-size:1.1rem;">@p.Carica del Comune di Paperopoli</p>
                    <p style="margin-top:.5rem;">
                        @foreach (var d in p.Deleghe) { <span class="fonte-chip">@d</span><text> </text> }
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(p.Biografia))
            {
                <h2>Biografia</h2>
                <p>@p.Biografia</p>
            }

            @if (p.Deleghe.Count > 0)
            {
                <h2>Deleghe</h2>
                <ul>@foreach (var d in p.Deleghe) { <li>@d</li> }</ul>
            }

            @if (!string.IsNullOrWhiteSpace(p.Ricevimento))
            {
                <h2>Ricevimento</h2>
                <p>@p.Ricevimento</p>
            }
            <p style="margin-top:.6rem;">
                <a class="btn-fumetto" href="/assistente?q=Come prendo appuntamento con @p.Carica?">Prendi appuntamento</a>
            </p>
        </div>

        <aside class="pannello-lato" aria-label="Contatti">
            <h2 class="display">Contatti</h2>
            <dl>
                @if (!string.IsNullOrWhiteSpace(p.Email)) { <dt>Segreteria</dt><dd>@p.Email</dd> }
                @if (!string.IsNullOrWhiteSpace(p.Telefono)) { <dt>Telefono</dt><dd>@p.Telefono</dd> }
            </dl>
            <p style="margin-top:.8rem;"><a href="/amministrazione/giunta">Vai alla Giunta comunale →</a></p>
        </aside>
    </div>
</section>
