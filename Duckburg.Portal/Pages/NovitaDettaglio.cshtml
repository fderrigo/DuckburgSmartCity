@page "/novita/dettaglio/{slug}"
@model NovitaDettaglioModel
@{
    var n = Model.Novita!;
    ViewData["Title"] = n.Titolo;
    ViewData["Nav"] = "novita";
    var it = new System.Globalization.CultureInfo("it-IT");
    var (label, lista, singolare) = n.Tipo switch
    {
        TipoNovita.Comunicato => ("Comunicati", "/novita/comunicati", "Comunicato"),
        TipoNovita.Avviso => ("Avvisi", "/novita/avvisi", "Avviso"),
        _ => ("Notizie", "/novita/notizie", "Notizia"),
    };
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item"><a href="/novita"><span>Novità</span></a></li>
        <li class="breadcrumb-item"><a href="@lista"><span>@label</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">@n.Titolo</span></a></li>
    </ol>
</nav>

<section class="wrap container-xl" aria-labelledby="titolo-novita" style="max-width:900px;">
    <span class="sezione-eyebrow">@singolare · @n.Data.ToString("d MMMM yyyy", it)</span>
    <h1 class="display sezione-titolo" id="titolo-novita">@n.Titolo</h1>
    <div class="scheda-corpo">
        <p style="font-weight:600;">@n.Sommario</p>
        <p>@n.Corpo</p>
        <dl class="mt-4">
            <dt>Data di pubblicazione</dt>
            <dd>@n.Data.ToString("d MMMM yyyy", it)</dd>
            @if (n.ACuraDi != null)
            {
                <dt>A cura di</dt>
                <dd><a href="/amministrazione/uffici/@n.ACuraDi.Slug">@n.ACuraDi.Nome</a></dd>
            }
            @if (n.Argomento != null)
            {
                <dt>Argomenti</dt>
                <dd><a class="argomento" href="/argomenti/@n.Argomento.Slug">@n.Argomento.Nome</a></dd>
            }
        </dl>
    </div>
    <p style="margin-top:1.4rem;"><a href="@lista">← Torna a @label.ToLowerInvariant()</a></p>
</section>
