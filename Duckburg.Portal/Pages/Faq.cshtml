@page "/faq"
@model FaqModel
@{
    ViewData["Title"] = "Domande frequenti";
    ViewData["Nav"] = "";
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">Domande frequenti</span></a></li>
    </ol>
</nav>

<section class="wrap container-xl" aria-labelledby="titolo-faq" style="max-width:900px;">
    <span class="sezione-eyebrow">Assistenza</span>
    <h1 class="display sezione-titolo" id="titolo-faq">Domande frequenti (FAQ)</h1>
    <p class="sezione-sub">
        Le risposte alle domande più comuni. Non trovi la tua? Chiedi all'<a href="/assistente">assistente virtuale</a>
        o contatta l'URP al numero verde 800-PAPERINO.
    </p>

    @foreach (var gruppo in Model.Gruppi)
    {
        <h2 class="display" style="font-size:1.4rem; margin:1.6rem 0 .8rem;">@gruppo.Key</h2>
        <div class="accordion" id="faq-@gruppo.Key.ToLowerInvariant().Replace(" ", "-")">
            @foreach (var f in gruppo)
            {
                <details class="card card-fumetto faq-item mb-2">
                    <summary class="card-body faq-domanda"><h3 style="display:inline; font-size:1rem;">@f.Domanda</h3></summary>
                    <div class="card-body faq-risposta"><p>@f.Risposta</p></div>
                </details>
            }
        </div>
    }
</section>
