@page "/novita"
@model NovitaModel
@{
    ViewData["Title"] = "Novità";
    ViewData["Nav"] = "novita";
    var it = new System.Globalization.CultureInfo("it-IT");
    var label = new Dictionary<TipoNovita, string> {
        [TipoNovita.Notizia] = "Notizia", [TipoNovita.Comunicato] = "Comunicato", [TipoNovita.Avviso] = "Avviso"
    };
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">Novità</span></a></li>
    </ol>
</nav>

<section class="wrap container-xl" aria-labelledby="titolo-novita">
    <span class="sezione-eyebrow">Novità</span>
    <h1 class="display sezione-titolo" id="titolo-novita">Novità</h1>
    <p class="sezione-sub">Le ultime dal Comune di Paperopoli. Contenuti dimostrativi.</p>

    <div class="card-grid row" style="margin-bottom:2.2rem;">
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="card-data">Categoria</span>
                    <a href="/novita/notizie" data-element="news-category-link"><h2 style="font-size:1.05rem;">Notizie</h2></a>
                    <p>I fatti e le storie dal Comune e dal territorio.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="card-data">Categoria</span>
                    <a href="/novita/comunicati" data-element="news-category-link"><h2 style="font-size:1.05rem;">Comunicati</h2></a>
                    <p>I comunicati stampa dell'amministrazione.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="card-data">Categoria</span>
                    <a href="/novita/avvisi" data-element="news-category-link"><h2 style="font-size:1.05rem;">Avvisi</h2></a>
                    <p>Scadenze, variazioni di servizio e avvisi ai cittadini.</p>
                </div>
            </div>
        </div>
    </div>

    <h2 class="display" style="font-size:1.5rem; margin-bottom:1rem;">Le ultime pubblicate</h2>
    <div class="card-grid row">
        @foreach (var n in Model.Novita)
        {
            <div class="col-12 col-md-4 mb-3">
                <div class="card card-fumetto h-100">
                    <div class="card-body">
                        <span class="card-data">@label[n.Tipo] · @n.Data.ToString("d MMMM yyyy", it)</span>
                        <a href="/novita/dettaglio/@n.Slug"><h3 style="font-size:1.02rem;">@n.Titolo</h3></a>
                        <p>@n.Sommario</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
