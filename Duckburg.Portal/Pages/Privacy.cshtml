@page "/privacy"
@model PrivacyModel
@{
    var p = Model.Pagina!;
    ViewData["Title"] = p.Titolo;
    ViewData["Nav"] = "";
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">@p.Titolo</span></a></li>
    </ol>
</nav>

<section class="wrap" aria-labelledby="titolo-pagina" style="max-width:820px;">
    <span class="sezione-eyebrow">@p.Sottotitolo</span>
    <h1 class="display sezione-titolo" id="titolo-pagina">@p.Titolo</h1>
    <div class="scheda-corpo">@Html.Raw(p.Corpo)</div>
</section>
