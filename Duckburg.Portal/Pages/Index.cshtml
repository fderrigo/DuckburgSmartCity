@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Nav"] = "";
    var novitaLabel = new Dictionary<TipoNovita, string> {
        [TipoNovita.Notizia] = "Notizia", [TipoNovita.Comunicato] = "Comunicato", [TipoNovita.Avviso] = "Avviso"
    };
    var it = new System.Globalization.CultureInfo("it-IT");
}

<!-- ============ 1. HERO: identità + assistente ============ -->
<section class="hero" aria-labelledby="titolo-hero">
    <svg class="quack" viewBox="0 0 200 140" aria-hidden="true">
        <polygon points="100,4 118,32 152,14 148,48 190,44 162,72 196,92 156,98 168,132 132,112 118,138 100,110 76,136 70,102 30,116 48,84 6,74 44,58 24,26 64,38 74,6 90,34"
                 fill="#F2B705" stroke="#17120E" stroke-width="4" stroke-linejoin="round"/>
        <text x="100" y="82" text-anchor="middle" font-family="Bangers, cursive" font-size="40" fill="#E23A2E" stroke="#17120E" stroke-width="1.2" transform="rotate(-6 100 76)">QUACK!</text>
    </svg>

    <div class="wrap container-xl hero-grid">
        <div class="col">
            <h1 class="display hero-titolo" id="titolo-hero">@Model.Get("hero.titolo", "Il Comune ti risponde!")</h1>
            <p class="hero-sub lead">@Model.Get("hero.sottotitolo", "Chiedi all'assistente virtuale e ricevi risposte tratte solo dalle fonti ufficiali del Comune.")</p>
        </div>
        <div class="balloon-hero col">
            <p class="balloon-chi">Assistente virtuale del Comune</p>
            <p class="frase">Ciao! Sono l'assistente di Paperopoli. Cosa vuoi sapere?</p>
            <form action="/assistente" method="get" class="form-group">
                <label class="visually-hidden" for="hero-domanda">Fai una domanda all'assistente virtuale</label>
                <input type="text" class="form-control" id="hero-domanda" name="q" autocomplete="off"
                       placeholder="@Model.Get("hero.placeholder", "Es. Quando scade la prima rata della TARI?")" />
                <button type="submit" class="btn btn-fumetto">Chiedi!</button>
            </form>
        </div>
    </div>
</section>

<!-- ============ 2. ARGOMENTI: banda di accesso rapido ============ -->
<section class="argomenti-banda" aria-labelledby="titolo-argomenti">
    <div class="wrap container-xl">
        <h2 class="argomenti-titolo" id="titolo-argomenti">Vai subito all'argomento che ti interessa</h2>
        <div class="argomenti">
            @foreach (var a in Model.Argomenti)
            {
                <a class="argomento" href="/argomenti/@a.Slug">@a.Nome</a>
            }
            <a class="argomento argomento-tutti" href="/argomenti" data-element="all-topics"><span>Tutti gli argomenti</span></a>
        </div>
    </div>
</section>

<!-- ============ 3. SERVIZI IN EVIDENZA ============ -->
<section class="wrap container-xl home-sezione" aria-labelledby="titolo-servizi" style="margin-bottom:52px">
    <div class="home-testa">
        <span class="sezione-eyebrow">Servizi</span>
        <h2 class="display sezione-titolo" id="titolo-servizi">I servizi più richiesti</h2>
        <a class="home-vedi-tutti" href="/servizi">Tutti i servizi →</a>
    </div>
    <div class="card-grid row g-4">
        @foreach (var s in Model.ServiziInEvidenza)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a class="card card-fumetto h-100 d-block" href="/servizi/@s.Slug">
                    <div class="card-body">
                        <span class="icona @s.ColoreIcona" aria-hidden="true">@PortalIcons.Render(s.IconaKey)</span>
                        <h3 class="card-title h5">@s.Titolo</h3>
                        <p class="card-text">@s.DescrizioneBreve</p>
                    </div>
                </a>
            </div>
        }
        <div class="col-12 col-md-6 col-lg-4">
            <a class="card card-fumetto h-100 d-block" href="/amministrazione/uffici">
                <div class="card-body">
                    <span class="icona oro" aria-hidden="true">@PortalIcons.Render("orologio")</span>
                    <h3 class="card-title h5">Uffici e orari</h3>
                    <p class="card-text">Dove siamo, quando riceviamo e come prendere appuntamento.</p>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ============ 4. NOVITÀ ============ -->
<section class="wrap container-xl home-sezione" aria-labelledby="titolo-novita">
    <div class="home-testa">
        <span class="sezione-eyebrow">Novità</span>
        <h2 class="display sezione-titolo" id="titolo-novita">Ultime dal Comune</h2>
        <a class="home-vedi-tutti" href="/novita">Tutte le novità →</a>
    </div>
    <div class="card-grid row g-4">
        @foreach (var n in Model.Novita)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a class="card card-fumetto h-100 d-block" href="/novita/dettaglio/@n.Slug">
                    <div class="card-body">
                        <span class="card-data badge">@novitaLabel[n.Tipo] · @n.Data.ToString("d MMMM yyyy", it)</span>
                        <h3 class="card-title h5">@n.Titolo</h3>
                        <p class="card-text">@n.Sommario</p>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- ============ 5. CHIUSURA: torna all'assistente ============ -->
<section class="wrap container-xl home-sezione" aria-labelledby="titolo-banner-assistente" style="margin-bottom: 80px;">
    <div class="balloon-hero home-cta">
        <p class="balloon-chi">Assistente virtuale</p>
        <h2 class="display" id="titolo-banner-assistente">Non trovi quello che cerchi?</h2>
        <p class="frase">Chiedi all'assistente: risponde solo con le fonti certificate del Comune e cita sempre il passaggio ufficiale, ad esempio <span class="fonte-chip">tari:p02</span></p>
        <a class="btn btn-fumetto" href="/assistente">Apri l'assistente</a>
    </div>
</section>
