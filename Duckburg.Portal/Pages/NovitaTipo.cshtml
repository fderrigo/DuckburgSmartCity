@page "/novita/{tipo:regex(^(notizie|comunicati|avvisi)$)}"
@model NovitaTipoModel
@{
    ViewData["Title"] = Model.Titolo;
    ViewData["Nav"] = "novita";
    var it = new System.Globalization.CultureInfo("it-IT");
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item"><a href="/novita"><span>Novità</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">@Model.Titolo</span></a></li>
    </ol>
</nav>

<section class="wrap container-xl" aria-labelledby="titolo-lista">
    <span class="sezione-eyebrow">Novità</span>
    <h1 class="display sezione-titolo" id="titolo-lista" data-element="page-name">@Model.Titolo</h1>

    <div class="card-grid row">
        @foreach (var n in Model.Novita)
        {
            <div class="col-12 col-md-4 mb-3">
                <div class="card card-fumetto h-100">
                    <div class="card-body">
                        <span class="card-data">@n.Data.ToString("d MMMM yyyy", it)</span>
                        <a href="/novita/dettaglio/@n.Slug"><h2 style="font-size:1.02rem;">@n.Titolo</h2></a>
                        <p>@n.Sommario</p>
                    </div>
                </div>
            </div>
        }
        @if (Model.Novita.Count == 0)
        {
            <p>Non ci sono contenuti in questa sezione.</p>
        }
    </div>
</section>
