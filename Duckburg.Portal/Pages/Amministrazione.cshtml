@page "/amministrazione"
@model AmministrazioneModel
@{
    ViewData["Title"] = "Amministrazione";
    ViewData["Nav"] = "amministrazione";
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">Amministrazione</span></a></li>
    </ol>
</nav>

<section class="wrap container-xl" aria-labelledby="titolo-amministrazione">
    <span class="sezione-eyebrow">Amministrazione</span>
    <h1 class="display sezione-titolo" id="titolo-amministrazione">Amministrazione</h1>
    <p class="sezione-sub">Come è organizzato il Comune di Paperopoli: organi di governo, uffici e documenti. Contenuti dimostrativi.</p>

    <div class="card-grid row">
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="card-data">Categoria</span>
                    <a href="/amministrazione/organi-di-governo" data-element="management-category-link">
                        <h2 style="font-size:1.05rem;">Organi di governo</h2>
                    </a>
                    <p>La Sindaca, la Giunta comunale e le cariche dell'ente.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="card-data">Categoria</span>
                    <a href="/amministrazione/uffici" data-element="management-category-link">
                        <h2 style="font-size:1.05rem;">Uffici</h2>
                    </a>
                    <p>Le unità organizzative del Comune: competenze, sedi e orari di ricevimento.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-3">
            <div class="card card-fumetto h-100">
                <div class="card-body">
                    <span class="card-data">Categoria</span>
                    <a href="/amministrazione/documenti-e-dati" data-element="management-category-link">
                        <h2 style="font-size:1.05rem;">Documenti e dati</h2>
                    </a>
                    <p>Statuto, regolamenti, carta dei servizi e dati aperti dell'ente.</p>
                </div>
            </div>
        </div>
    </div>

    <p style="margin-top:1.6rem;">
        Hai una domanda su un ufficio? <a href="/assistente?q=Quali sono gli orari degli uffici comunali?">Chiedi all'assistente</a>.
    </p>
</section>
