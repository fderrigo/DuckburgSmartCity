@page "/amministrazione/giunta"
@model AmministrazioneGiuntaModel
@{
    ViewData["Title"] = "La Giunta comunale";
    ViewData["Nav"] = "amministrazione";
}

<nav class="wrap container-xl briciole" aria-label="Percorso di navigazione">
    <ol class="breadcrumb" data-element="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><span>Home</span></a></li>
        <li class="breadcrumb-item"><a href="/amministrazione"><span>Amministrazione</span></a></li>
        <li class="breadcrumb-item"><a href="/amministrazione/organi-di-governo"><span>Organi di governo</span></a></li>
        <li class="breadcrumb-item active"><a><span aria-current="page">La Giunta comunale</span></a></li>
    </ol>
</nav>

<section class="wrap" aria-labelledby="titolo-giunta">
    <span class="sezione-eyebrow">Organi di governo</span>
    <h1 class="display sezione-titolo" id="titolo-giunta">La Giunta comunale</h1>
    <p class="sezione-sub">
        La Giunta si riunisce il lunedì al Palazzo Comunale ed è composta dalla
        <a href="/amministrazione/sindaco">Sindaca</a> e dagli assessori. Tutti i personaggi sono di fantasia.
    </p>

    <div class="card-grid">
        @foreach (var p in Model.Giunta)
        {
            <article class="card-fumetto">
                <span style="width:96px; height:96px; display:inline-block;">@Html.Raw(p.RitrattoSvg)</span>
                <span class="card-data">@p.Carica</span>
                <h2 style="font-size:1.05rem;">@p.Nome</h2>
                @if (p.Deleghe.Count > 0)
                {
                    <p><strong>Deleghe:</strong> @string.Join(", ", p.Deleghe).</p>
                }
                @if (!string.IsNullOrWhiteSpace(p.Ricevimento))
                {
                    <p>@p.Ricevimento</p>
                }
            </article>
        }
    </div>

    <p style="margin-top:1.6rem;">
        Domande sulle deleghe? <a href="/assistente?q=Chi si occupa dei tributi in Comune?">Chiedi all'assistente</a>.
    </p>
</section>
